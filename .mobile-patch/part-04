+
+    output.yAxis = mapCollection(source.yAxis, (axis) => ({
+      ...axis,
+      name: '',
+      nameGap: 0,
+      axisLabel: {
+        ...(axis.axisLabel ?? {}),
+        fontSize: 10,
+        hideOverlap: true,
+        margin: 7,
