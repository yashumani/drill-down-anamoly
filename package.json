{
  "name": "drill-down-anomaly-lab",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
