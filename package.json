    "smoke:public-data": "node scripts/live-public-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
